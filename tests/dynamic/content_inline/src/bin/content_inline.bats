#include "share/atspre_staload.hats"
#use array as A


implement main0 () = let
  val (len | a) = $A.barr_alloc(4)
  val (s0 | a) = $A.barr_set_inline(a, 0, 65)
  val (s1 | a) = $A.barr_set_inline(a, 1, 255)
  val (s2 | a) = $A.barr_set_inline(a, 3, 0)
  val b = $A.barr_copy(a, 4)
  val (r0 | v0) = $A.barr_get_inline(b, 0)
  val (r1 | v1) = $A.barr_get_inline(b, 1)
  val (r2 | v2) = $A.barr_get_inline(b, 2)
  val (r3 | v3) = $A.barr_get_inline(b, 3)
  val () = println! (v0, " ", v1, " ", v2, " ", v3)
  val raw = $A.barr_to_arr(a)
  val () = $A.set<byte>(raw, 2, $A.int2byte(7))
  val (len2 | back) = $A.barr_of_arr(raw)
  val (r4 | v4) = $A.barr_get_inline(back, 2)
  val () = println! (v4)
  val () = $A.barr_free(back)
  val () = $A.barr_free(b)
  val (len3 | w) = $A.barr_alloc(7)
  val (w0 | w) = $A.barr_set_inline(w, 1, 1)
  val (w1 | w) = $A.barr_set_inline(w, 2, 255)
  val (w2 | w) = $A.barr_set_inline(w, 3, 128)
  val (w3 | w) = $A.barr_set_inline(w, 4, 127)
  val (w4 | w) = $A.barr_set_inline(w, 6, 9)
  val (p0, p1, p2, p3 | @(x0, x1, x2, x3)) = $A.barr_get_be32_inline(w, 1)
  val () = println! (x0, " ", x1, " ", x2, " ", x3)
  val (q0 | c0) = $A.barr_get_inline(w, 1)
  val (q3 | c3) = $A.barr_get_inline(w, 4)
  prval () = $A.nth_functional(p0, q0)
  prval () = $A.nth_functional(p3, q3)
  val (q1 | c1) = $A.barr_get_inline(w, 2)
  val (q2 | c2) = $A.barr_get_inline(w, 3)
  prval () = $A.nth_functional(p1, q1)
  prval () = $A.nth_functional(p2, q2)
  val () = println! (c0, " ", c3)
  val (r0, r1, r2, r3 | @(y0, y1, y2, y3)) = $A.barr_get_be32_inline(w, 0)
  val () = println! (y0, " ", y1, " ", y2, " ", y3)
  val (s0, s1, s2, s3 | @(z0, z1, z2, z3)) = $A.barr_get_be32_inline(w, 3)
  val () = println! (z0, " ", z1, " ", z2, " ", z3)
  val () = $A.barr_free(w)
in () end
